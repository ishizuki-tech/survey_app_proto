    "d7_residue":{"id":"d7_residue","type":"single","ui":{"originalType":"multi"},"title":"D7. Leftover plant material disposition (select all that apply)","var":"d_residue","options":[{"key":"left_on_field","label":"Left it on field"},{"key":"feed_livestock","label":"Feed for livestock"},{"key":"mulch_other_plots","label":"Transported to other plots as mulch"},{"key":"burned","label":"Burned in field"},{"key":"other","label":"Other (specify)"}],"required":false,"nextId":"d7_residue_other_text"},
    "d7_residue_other_text":{"id":"d7_residue_other_text","type":"free","title":"Specify 'other' (D7) if selected","var":"d_residue_other_text","required":false,"nextId":"e1_phone"},
