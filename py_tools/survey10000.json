    "d6_bags_breakdown_food":{"id":"d6_bags_breakdown_food","type":"free","ui":{"originalType":"number","integer":true,"min":0},"title":"D6. Bags stored for household food","var":"d_bags_food","required":false,"validate":{"integer":true,"min":0},"nextId":"d6_bags_breakdown_given"},
    "d6_bags_breakdown_given":{"id":"d6_bags_breakdown_given","type":"free","ui":{"originalType":"number","integer":true,"min":0},"title":"D6. Bags given to others (schools, church, etc.)","var":"d_bags_given","required":false,"validate":{"integer":true,"min":0},"nextId":"d6_bags_breakdown_feed"},
