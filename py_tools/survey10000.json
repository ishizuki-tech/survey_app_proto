    "end_ineligible_no_role":{"id":"end_ineligible_no_role","type":"end","title":"Interview ended — ineligible","reason":"No role in maize farming.","recordVar":"eligibility_reason"},
    "q_end_complete":{"id":"q_end_complete","type":"end","title":"Interview complete — thank you!","reason":"Completed"}
