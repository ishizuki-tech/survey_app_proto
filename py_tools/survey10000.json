    "d6_bags_breakdown_other":{"id":"d6_bags_breakdown_other","type":"free","ui":{"originalType":"number","integer":true,"min":0},"title":"D6. Bags used for other (specify)","var":"d_bags_other","required":false,"validate":{"integer":true,"min":0},"nextId":"d6_bags_breakdown_other_text"},
