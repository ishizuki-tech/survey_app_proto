  "derivedOutputs": [
    {"id":"eligibility_flag","title":"Eligibility flag & reason","expr":"({ eligible: (maize_now==true) || (maize_last3y==true && a3iii_only_no_role==false), reason: (maize_now==false && maize_last3y==false) ? 'No maize farming current or in past 3 years.' : (a3iii_only_no_role ? 'No role in maize farming.' : 'Eligible') })"},
    {"id":"preference_ranking","title":"Preference (most/least)","expr":"{ most: b7_most, least: b7_least }"},
    {"id":"interest_delta","title":"Interest delta by concept (try vs replace)","expr":"{ v1: (Number(b6_replace_v1)-Number(b5_try_v1)), v2: (Number(b6_replace_v2)-Number(b5_try_v2)), v3: (Number(b6_replace_v3)-Number(b5_try_v3)) }"},
    {"id":"income_dependency","title":"Income dependency (combine C6 & C7)","expr":"{ importance_offfarm: Number(c_offfarm_importance), balance: c_income_balance }"},
    {"id":"seed_purchase_profile","title":"Seed purchase recency/frequency profile","expr":"{ purchased_5y: d_seed_purchased_5y===true, freq: d_purchase_freq || null }"},
    {"id":"cropping_intensity_consistency","title":"Cropping intensity consistency (D4e ≤ C2)","expr":"{ ok: Number(d_maize_area_main) <= Number(c_maize_area_prev), main: Number(d_maize_area_main), prev: Number(c_maize_area_prev) }"}
  ],
