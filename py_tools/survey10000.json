    "d1_seasons":{"id":"d1_seasons","type":"single","title":"D1. Number of maize seasons per year","var":"d_seasons","required":true,"options":[{"key":"1","label":"One"},{"key":"2","label":"Two"},{"key":"3","label":"Three"}],"nextId":"d2_seed_purchased_5y"},
