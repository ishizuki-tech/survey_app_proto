    "d3_purchase_freq":{"id":"d3_purchase_freq","type":"single","title":"D3. Frequency of seed purchase","var":"d_purchase_freq","options":[{"key":"every_season","label":"Every season"},{"key":"most_seasons","label":"Most seasons"},{"key":"occasionally","label":"Occasionally"},{"key":"once","label":"Once"},{"key":"other","label":"Other"}],"required":true,"nextId":"d4a_cropping_system"},
    "d4a_cropping_system":{"id":"d4a_cropping_system","type":"single","title":"D4a. Cropping system in main season","var":"d_cropping_system","options":[{"key":"mono","label":"Monocrop"},{"key":"intercrop_legumes","label":"Intercrop with legumes"},{"key":"intercrop_trees_other","label":"Intercrop with trees/other"},{"key":"both","label":"Both"}],"required":true,"nextId":"d4b_seed_kg"},
