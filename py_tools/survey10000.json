    "d4c_variety_count":{"id":"d4c_variety_count","type":"free","ui":{"originalType":"number","integer":true,"min":0},"title":"D4c. # of different varieties grown (main season)","var":"d_variety_count","required":true,"validate":{"integer":true,"min":0},"nextId":"d4d_varieties"},
