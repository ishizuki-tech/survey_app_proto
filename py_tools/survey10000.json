    "b1_agdealer_gender":{"id":"b1_agdealer_gender","type":"single","title":"B1. Randomly assigned agro-dealer gender (record)","var":"agdealer_gender","options":[{"key":"male","label":"Male"},{"key":"female","label":"Female"}],"required":true,"nextId":"b_intro_video"},
